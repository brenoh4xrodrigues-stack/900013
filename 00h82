-- 🎯 FUNÇÃO PRINCIPAL: EXECUTAR SCRIPTS COM MÁXIMA PROTEÇÃO
local function executeProtectedScript(originalUrl)
    print("[🔐] Executando script com proteção contra pintos...")
    
    -- CAMADA 1: Ofuscar URL
    local obfuscated = obfuscateUrl(originalUrl)
    
    -- CAMADA 2: Encriptar com XOR
    local encrypted = xorEncrypt(originalUrl, "MEOWLZZ_SECURITY_2025")
    
    -- CAMADA 3: Esconder em closure
    local urlLoader = createUrlLoader(encrypted, "MEOWLZZ_SECURITY_2025")
    
    -- CAMARA 4: Buscar código (sem expor URL)
    local code
    pcall(function()
        code = urlLoader()
        urlLoader = nil  -- Limpar
    end)
    
    if not code then
        print("[❌] Falha ao carregar script")
        return false
    end
    
    -- CAMADA 5: Executar (sem expor URL)
    originalUrl = nil  -- Limpar original
    obfuscated = nil
    encrypted = nil
    
    pcall(function()
        loadstring(code)()
    end)
    
    code = nil  -- Limpar código após execução
    
    print("[✅] Script executado com sucesso pinto grosso")
    return true
end

