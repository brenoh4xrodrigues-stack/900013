-- ✅ TÉCNICA 1: ENCRIPTAÇÃO XOR SIMPLES
local function xorEncrypt(str, key)
    local result = ""
    for i = 1, #str do
        result = result .. string.char(bit32.bxor(string.byte(str, i), string.byte(key, ((i - 1) % #key) + 1)))
    end
    return result
end

local function xorDecrypt(str, key)
    return xorEncrypt(str, key) -- XOR é reversível
end

-- ✅ TÉCNICA 2: BASE64 ENCODING
local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

local function base64Encode(str)
    return ((str:gsub('.', function(x)
        local r,b='',x:byte()
        for i=7,0,-1 do r=r..(b%2^(i+1)-b%2^i>0 and '1' or '0') end
        return r;
    end)..'0000'):gsub('%d%d%d%d%d%d', function(x)
        if (#x < 6) then return '' end
        local c=0
        for i=1,6 do c=c+(x:sub(i,i)=='1' and 2^(6-i) or 0) end
        return b64chars:sub(c+1,c+1)
    end)..({'','==','='})[#str%3+1])
end

local function base64Decode(str)
    str = str:gsub('[^'..b64chars..'=]', '')
    return ((str:gsub('.', function(x)
        if (x == '=') then return '' end
        local r,f='',(b64chars:find(x)-1)
        for i=5,0,-1 do r=r..(f%2^(i+1)-f%2^i>0 and '1' or '0') end
        return r;
    end)..'0000'):gsub('%d%d%d%d%d%d%d%d', function(x)
        if (#x ~= 8) then return '' end
        local c=0
        for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
        return string.char(c) end))
end

-- ✅ TÉCNICA 3: QUEBRAR STRING PATTERNS
local function obfuscateUrl(url)
    -- Quebra a URL em pedaços para evitar getgc() encontrar string inteira
    local parts = {}
    local chunkSize = 15
    
    for i = 1, #url, chunkSize do
        table.insert(parts, url:sub(i, i + chunkSize - 1))
    end
    
    return parts
end

local function reconstructUrl(parts)
    return table.concat(parts, "")
end

-- ✅ TÉCNICA 4: USAR VARIABLES DINÂMICAS
local function hideUrl(url)
    -- Armazena em uma tabela com índices aleatórios
    local hidden = {}
    local key = math.random(1000, 9999)
    
    hidden[key] = xorEncrypt(url, tostring(key))
    hidden["k"] = key
    
    return hidden
end

local function unhideUrl(hidden)
    local key = hidden["k"]
    return xorDecrypt(hidden[key], tostring(key))
end

-- ✅ TÉCNICA 5: EXECUTAR URL PROTEGIDO
local function secureLoadstring(url)
    -- Criptografa, quebra e esconde a URL
    local encrypted = xorEncrypt(url, "SHIELD_KEY_2025")
    local parts = obfuscateUrl(encrypted)
    
    -- Executa sem deixar a URL em claro na memória
    local reconstructed = table.concat(parts, "")
    local decrypted = xorDecrypt(reconstructed, "SHIELD_KEY_2025")
    
    -- Busca e executa o script
    local success, result = pcall(function()
        return game:HttpGet(decrypted)
    end)
    
    if success then
        -- Executa sem deixar string de URL visível
        local scriptFunc = loadstring(result)
        decrypted = nil  -- Limpa da memória
        return scriptFunc()
    else
        print("[ERRO] Falha ao buscar script: " .. result)
        return false
    end
end

-- ✅ TÉCNICA 6: USAR CLOSURE PARA ESCONDER URLS
local function createUrlLoader(encryptedUrl, key)
    return function()
        -- A URL só existe dentro dessa closure
        local url = xorDecrypt(encryptedUrl, key)
        return game:HttpGet(url)
    end
end

